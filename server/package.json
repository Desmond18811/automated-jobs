{
  "name": "javi-server",
  "version": "0.1.0",
  "private": true,
  "description": "JAVI API and workers: job discovery, matching, fact-guarded documents, and multi-channel applying",
  "scripts": {
    "dev": "nodemon",
    "dev:worker": "nodemon --watch src --ext ts,json --exec tsx src/worker.ts",
    "dev:tsx": "tsx watch src/index.ts",
    "seed": "tsx src/scripts/seed.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test": "tsx src/scripts/testEndpoints.ts",
    "test:auth": "tsx src/scripts/testPasswordlessAuth.ts",
    "test:endpoints": "tsx src/scripts/testEndpoints.ts",
    "test:openrouter": "tsx src/scripts/testOpenRouter.ts",
    "test:form-whatsapp": "tsx src/scripts/testFormAndWhatsApp.ts",
    "test:profile": "tsx src/scripts/testProfileSetup.ts",
    "test:live": "tsx src/scripts/testLiveApply.ts",
    "test:business": "tsx src/scripts/testBusinessMode.ts",
    "test:tailored-stripe": "tsx src/scripts/testStripeTailoredApply.ts",
    "typecheck": "tsc --noEmit",
    "setup:browser": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "mongoose": "^8.9.0",
    "multer": "^2.0.1",
    "nodemailer": "^10.6.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.6.0",
    "playwright": "^1.49.1",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.4",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
