# ==============================================================================
# J.A.V.I Server .gitignore
# ==============================================================================

# Secrets and environment files
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
._env

# Allow example files
!.env.example
!.env.template

# Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.secret
secret.json
secrets.json
credentials.json
client_secret*.json
service-account*.json
token.json
tokens.json

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# Build & Compilation outputs
dist/
build/
out/
*.tsbuildinfo

# Local Databases, Uploads & Storage
data/
storage/
uploads/
downloads/
pids/
*.pid
*.seed
*.pid.lock
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal
*.db-shm
*.db-wal

# Playwright & Browser Binaries
browsers/
userData/
test-results/
playwright-report/
playwright/.cache/
blob-report/
sessions/
session/
*.har

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache
.prettiercache
.rpt2_cache/
.turbo/

# System and OS files
.DS_Store
.DS_Store?
._*
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
tmp/
temp/
.data/
