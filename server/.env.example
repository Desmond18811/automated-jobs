# AI Provider configuration
# AI_PROVIDER=               optional: force anthropic | openrouter | qwen | deepseek for text
# Note: Reading scanned PDFs directly needs ANTHROPIC_API_KEY.
# OPENROUTER_VISION_MODEL=   a vision-capable OpenRouter model, needed to read flyer photos without ANTHROPIC_API_KEY
# QWEN_VISION_MODEL=         optional, same idea for Qwen

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.8-max-0902
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# QWEN_API_KEY=
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# PORT=4000
# BROWSER_CHANNEL=
# (blank = Playwright's Chromium; "chrome" = my installed Google Chrome)

# SMTP settings for email applications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# (465 = TLS, 587 = STARTTLS)
# SMTP_USER=ada@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# (For Gmail: host smtp.gmail.com, port 465, and SMTP_PASS = a Google app password. The account needs 2-Step Verification. Never the normal password.)
# SMTP_FROM="Ada Obi <ada@gmail.com>"
# MAIL_REDIRECT_TO=
# (Testing: when set, every email goes to this address instead, and the subject starts with "[TEST to <real address>] ")

# WhatsApp alerts
# WHATSAPP_PROVIDER=          textmebot | callmebot | cloudapi | blank = off
# WHATSAPP_TO=                my WhatsApp number, country code first, digits only, e.g. 2348012345678
# DASHBOARD_URL=http://localhost:5173
# (For mobile access over local Wi-Fi: DASHBOARD_URL=http://<my-LAN-IP>:5173. Caution: anyone on your local Wi-Fi can open it.)
# TEXTMEBOT_APIKEY=
# CALLMEBOT_APIKEY=
# WHATSAPP_TOKEN=             Cloud API permanent system-user token
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=     copied from the API Setup sample request
# WHATSAPP_TEMPLATE=job_autopilot_update
# WHATSAPP_TEMPLATE_PARAMS=event,title,reason   (use title,reason,link only if you still use the old 3-variable template)
# WHATSAPP_TEMPLATE_LANG=en

# Step 14 WhatsApp Interactive Webhook (Cloud API only)
# WEBHOOK_PORT=4100
# WHATSAPP_VERIFY_TOKEN=      random secret string for webhook challenge verification
# WHATSAPP_APP_SECRET=        Meta App Secret from App Dashboard -> App settings -> Basic
# WHATSAPP_FROM_ID=           optional sender ID if WhatsApp usernames mask phone number


