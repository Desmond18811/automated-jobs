# ---- Core ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
# Local MongoDB or MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@javi.zemhxfj.mongodb.net/javi?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
# CVs, generated PDFs and form screenshots live here (move to S3/R2 later)
STORAGE_DIR=./storage

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
# Sign-in is passwordless (emailed link + 6-digit code). A session ends after 30 idle days or 90 days total.
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# ---- Email (sign-in links + codes). Required in production; without it dev prints them to the terminal ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=J.A.V.I <no-reply@example.com>
SMTP_SECURE=false
# Encrypts stored Gmail refresh tokens. Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# ---- Gmail (Google Cloud console > Credentials > OAuth client, type "Web application") ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback

# ---- LLM (OpenRouter: Claude Opus / Sonnet for CV tailoring, pitch synthesis & questions) ----
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
LLM_MODEL=anthropic/claude-opus-5
ANTHROPIC_API_KEY=

# ---- WhatsApp Alerts & Replies ----
# Alerts always go to the user's own profile phone. WHATSAPP_TO is only for test scripts.
# Every "needs you" alert carries a one-tap answer link (works with any provider).
# To also answer by replying in WhatsApp ("4821 yes", "4821 done"), use Twilio:
#   1. Twilio console → Messaging → Try WhatsApp (sandbox); join it from your phone.
#   2. Expose the API: `cloudflared tunnel --url http://localhost:4000` (or ngrok) and set API_URL to that https URL.
#   3. Sandbox settings → "When a message comes in": POST {API_URL}/api/webhooks/whatsapp/twilio
#   4. Set WHATSAPP_PROVIDER=twilio and the three TWILIO_* values below.
WHATSAPP_PROVIDER=textmebot
WHATSAPP_TO=
TEXTMEBOT_APIKEY=
CALLMEBOT_APIKEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Applying in a visible browser ----
# live: JAVI opens its own Brave/Chrome window (separate profile under STORAGE_DIR/browser-profile),
#       fills forms there, and pauses with the page open when it needs you. Sign in to Google once in
#       that window so "Continue with Google" works everywhere.
# headless: the old invisible server-side Chromium (default in production).
APPLY_BROWSER=live
LIVE_BROWSER_PATH=
LIVE_BROWSER_PORT=9333
LIVE_WAIT_MINUTES=30
# Read sign-up verification codes from Gmail instead of asking (adds the gmail.readonly scope; reconnect Gmail after enabling).
GMAIL_READ_CODES=false
# A user's first N form applications are filled and screenshotted, then wait for them to confirm (0 = off).
FORM_DRY_RUN_FIRST=3
# /api/test/* demo routes skip the safety rules; never enable in production.
ENABLE_TEST_ROUTES=false

# ---- Business Mode ----
# Lead search uses OpenStreetMap (free, no key). Overpass servers are tried in order when one is busy.
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
OSM_COUNTRY_CODES=ng
# Your contact (email or site) for the OSM usage policy; sent in the User-Agent.
OSM_CONTACT=
# Optional: PageSpeed Insights key, adds a mobile speed score to website audits.
PAGESPEED_API_KEY=

# ---- Job sources ----
# JAVI never scrapes job boards. Sources are official APIs/feeds: RemoteOK, RSS, Adzuna, and the public
# board APIs of Greenhouse, Lever, Ashby, Workable and SmartRecruiters (for career pages you add).
# LinkedIn, Indeed, Upwork, Glassdoor, Jobberman and Fiverr links are applied to in assisted mode only.
# Comma-separated RSS feeds. Add MyJobMag/Jobberman feeds only after checking their terms (or getting a partnership feed).
RSS_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss
REMOTEOK_ENABLED=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
INGEST_EVERY_MINUTES=180
MATCH_THRESHOLD=0.35