# ---- Core ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
# Local MongoDB or MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@javi.zemhxfj.mongodb.net/javi?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
# CVs, generated PDFs and form screenshots live here (move to S3/R2 later)
STORAGE_DIR=./storage

# ---- Auth ----
# Clerk Authentication (App ID: app_3FsNa4ILCoP5o9iSRJ7OdhAyiJv)
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
# Encrypts stored Gmail refresh tokens. Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# ---- Gmail (Google Cloud console > Credentials > OAuth client, type "Web application") ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback

# ---- LLM (OpenRouter: Claude Opus / Sonnet for CV tailoring, pitch synthesis & questions) ----
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
LLM_MODEL=anthropic/claude-opus-5
ANTHROPIC_API_KEY=

# ---- WhatsApp Alerts & Replies ----
# Alerts always go to the user's own profile phone. WHATSAPP_TO is only for test scripts.
# Every "needs you" alert carries a one-tap answer link (works with any provider).
# To also answer by replying in WhatsApp ("4821 yes", "4821 done"), use Twilio:
#   1. Twilio console → Messaging → Try WhatsApp (sandbox); join it from your phone.
#   2. Expose the API: `cloudflared tunnel --url http://localhost:4000` (or ngrok) and set API_URL to that https URL.
#   3. Sandbox settings → "When a message comes in": POST {API_URL}/api/webhooks/whatsapp/twilio
#   4. Set WHATSAPP_PROVIDER=twilio and the three TWILIO_* values below.
WHATSAPP_PROVIDER=textmebot
WHATSAPP_TO=
TEXTMEBOT_APIKEY=
CALLMEBOT_APIKEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Applying in a visible browser ----
# live: JAVI opens its own Brave/Chrome window (separate profile under STORAGE_DIR/browser-profile),
#       fills forms there, and pauses with the page open when it needs you. Sign in to Google once in
#       that window so "Continue with Google" works everywhere.
# headless: the old invisible server-side Chromium (default in production).
APPLY_BROWSER=live
LIVE_BROWSER_PATH=
LIVE_BROWSER_PORT=9333
LIVE_WAIT_MINUTES=30
# Read sign-up verification codes from Gmail instead of asking (adds the gmail.readonly scope; reconnect Gmail after enabling).
GMAIL_READ_CODES=false

# ---- Job sources ----
# Comma-separated RSS feeds: We Work Remotely category feeds, plus MyJobMag/Jobberman feeds if they publish them
RSS_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss
REMOTEOK_ENABLED=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
INGEST_EVERY_MINUTES=180
MATCH_THRESHOLD=0.35