{
  "watch": ["src"],
  "ext": "ts,json",
  "ignore": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "node_modules",
    "data/**",
    "storage/**",
    "dist/**",
    ".git"
  ],
  "exec": "tsx src/index.ts",
  "delay": 600,
  "restartable": "rs",
  "env": {
    "NODE_ENV": "development"
  }
}
