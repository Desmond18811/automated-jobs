# ==============================================================================
# J.A.V.I Root Environment Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file with secrets to Git.
# ==============================================================================

# Core & Server
PORT=4000
DASHBOARD_URL=http://localhost:5173
BROWSER_CHANNEL=brave

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@javi.zemhxfj.mongodb.net/javi?retryWrites=true&w=majority

# LLM Providers (OpenRouter: Claude Opus / Sonnet for CV tailoring & job applications)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
LLM_MODEL=anthropic/claude-opus-5
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# WhatsApp Alerts & Notifications (TextMeBot / CallMeBot / Twilio / Meta Cloud)
# When JAVI tailors your CV, fills job forms, or applies to roles, instant status alerts are texted here.
WHATSAPP_PROVIDER=textmebot
WHATSAPP_TO=2349025958370
TEXTMEBOT_APIKEY=2qXNzBC699fH
CALLMEBOT_APIKEY=
WEBHOOK_PORT=4100
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token

# SMTP Settings for Automated Email Applications
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=JAVI

# Auth & Encryption Secrets (generate strong random secrets)
# Clerk Authentication (App ID: app_3FsNa4ILCoP5o9iSRJ7OdhAyiJv)
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder

JWT_ACCESS_SECRET=your_jwt_access_secret_at_least_32_chars
TOKEN_ENC_KEY=your_base64_encoded_32_byte_token_encryption_key
