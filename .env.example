# ==============================================================================
# J.A.V.I Root Environment Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file with secrets to Git.
# ==============================================================================

# Core & Server
PORT=4000
DASHBOARD_URL=http://localhost:5173
BROWSER_CHANNEL=brave

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@javi.zemhxfj.mongodb.net/javi?retryWrites=true&w=majority

# LLM Providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.8-max-0902
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# WhatsApp Alerts (TextMeBot / CallMeBot / Cloud API)
WHATSAPP_PROVIDER=textmebot
WHATSAPP_TO=your_phone_number_here
TEXTMEBOT_APIKEY=your_textmebot_key
CALLMEBOT_APIKEY=your_callmebot_key
WEBHOOK_PORT=4100
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token

# SMTP Settings for Automated Email Applications
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=JAVI

# Auth & Encryption Secrets (generate strong random secrets)
